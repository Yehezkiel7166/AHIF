{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "schema_version",
    "evidence_id",
    "execution_id",
    "status",
    "artifacts",
    "collected_at",
    "collector",
    "comments"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "evidence_id": {
      "type": "string",
      "minLength": 1
    },
    "execution_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "MISSING",
        "PENDING",
        "AVAILABLE",
        "REJECTED"
      ]
    },
    "artifacts": {
      "type": "array",
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "type": "object",
        "required": [
          "artifact_type",
          "path",
          "sha256"
        ],
        "properties": {
          "artifact_type": {
            "type": "string",
            "enum": [
              "IMAGE",
              "PROMPT_PACKAGE",
              "ADAPTER_RESPONSE",
              "REVIEW_ATTACHMENT"
            ]
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "sha256:[0-9a-f]{64}"
          }
        }
      }
    },
    "collected_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "collector": {
      "type": [
        "string",
        "null"
      ]
    },
    "comments": {
      "type": "string"
    }
  }
}
